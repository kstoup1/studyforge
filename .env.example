# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string. For local dev, run `npx prisma dev` and it will print
# one for you (see README). In production this points at your Neon database.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/studyforge_dev?sslmode=disable"

# Local `npx prisma dev` (PGlite) only handles one connection at a time -- see
# src/lib/db.ts. Remove this line when pointing at a real Postgres (e.g. Neon).
DATABASE_POOL_MAX=1

# Your own Anthropic API key (https://console.anthropic.com/) — used server-side only
# to generate flashcards from uploaded notes. Never exposed to the client.
ANTHROPIC_API_KEY=""

# Which AI writes the flashcards: "ollama" (free, local, no key -- needs Ollama running
# with the model pulled: `ollama pull llama3.1`) or "anthropic" (Claude, needs
# ANTHROPIC_API_KEY). Leave empty to use Claude when a key is set, Ollama otherwise.
LLM_PROVIDER=""
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Auth.js — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
# (NOT `npx auth secret` -- that installs and runs a different, unrelated library
# called Better Auth and prints BETTER_AUTH_SECRET, which Auth.js never reads.)
AUTH_SECRET=""

# Auth.js refuses every request in production mode ("UntrustedHost") unless it
# runs on Vercel (auto-detected) or this is set. Needed for `next start` locally
# or any non-Vercel host; harmless on Vercel.
AUTH_TRUST_HOST=true

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials).
# Optional for local dev if you only use the Credentials (email/password) sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Inngest (https://app.inngest.com/) — used for the async note-processing pipeline.
# For local dev: run `npx inngest-cli dev` and set INNGEST_DEV="1" (no keys needed).
# For production: unset INNGEST_DEV and set the two keys below instead.
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
