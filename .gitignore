# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI coding assistant reference docs auto-installed by `prisma init` (prisma/skills on
# GitHub) — vendor tooling for whichever AI assistant is helping on this repo, not
# application code. Re-fetchable any time via `npx prisma skills` if needed again.
/.agents/
/.claude/skills/
/.windsurf/
skills-lock.json
